# ==============================================================================
# FixIt Environment Variables Template
# Copy this file to .env and adjust values for your environment.
# DO NOT COMMIT SENSITIVE PASSWORDS OR PRODUCTION SECRETS TO VERSION CONTROL.
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=fixit_db
DB_USER=postgres
DB_PASSWORD=your_secure_postgres_password_here

# Backend Server Configuration (Spring Boot)
PORT=8080

# Frontend Configuration (Vite + React)
VITE_API_BASE_URL=http://localhost:8080
